    {
      "id": 1003,
      "titre": "Le coq",
      "auteur": "anonyme",
      "niveau": 1,
      "index": 102,
      "minutes": 2,
      "texte": "Chez nous, le coq chante avant le réveil. Papa dit que c'est le meilleur réveil du monde. Il ne tombe jamais en panne, mais il ne connaît pas le dimanche.",
      "acces": "gratuit",
      "versionAppMin": 35,
