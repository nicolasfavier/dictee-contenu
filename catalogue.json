    {
      "id": 1002,
      "titre": "Le téléphone de grand-mère",
      "auteur": "anonyme",
      "niveau": 1,
      "index": 101,
      "minutes": 2,
      "texte": "Ma grand-mère a un téléphone neuf. Elle parle très fort dedans, car elle pense que sa voix doit aller jusqu'au village. Tout le quartier connaît maintenant la vie de sa famille.",
      "acces": "gratuit",
      "versionAppMin": 35,
      "nbSegments": 6,
